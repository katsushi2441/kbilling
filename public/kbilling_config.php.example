// define('KBIL_TAX_RATE', 10);
// お支払期限を発行日から何日後にするか。
// define('KBIL_DUE_DAYS', 30);

/* ── 6. 支払いページの厳しさ（任意） ──────────────
 * true にすると、お客様が支払いページを開くときに宛先メールアドレスの
 * 入力を求めます（URL＋メールアドレスの2つが揃わないと開かない）。
 *
 * 既定は false です。請求書のリンクは払ってもらうためのもので、確認を挟むと
 * 支払いが止まるためです。社外秘の取引が多いなど、情報漏洩の方を重く見る
 * 場合に true にしてください。
// define('KBIL_PAY_REQUIRE_EMAIL', true);
 */

