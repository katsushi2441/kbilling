<?php
/**
 * 実行時設定。このファイルをコピーして kbilling_config.php を作り、
 * 自分の値に書き換えてください。kbilling_config.php はリポジトリに入りません。
 *
 * 未設定の項目は請求書に印字されません。
 */

/* ── 1. ログイン ─────────────────────────────
 * 管理パスワードのハッシュを作って貼ります。
 *   php scripts/make_password_hash.php 'あなたのパスワード'
 * 設定しないと管理画面には入れません。 */
define('KBIL_ADMIN_PASSWORD_HASH', '');

/* ── 2. 発行元 ─────────────────────────────── */
define('KBIL_NAME', '株式会社サンプル');

// 送信元メールアドレス。
// 【重要】共有サーバーから送る場合、そのサーバーが送信ドメインのSPFに
// 含まれていないと、受信側に捨てられます。届かないときはまずここを疑ってください。
//   確認: dig +short TXT example.co.jp | grep spf
define('KBIL_MAIL_FROM', 'info@example.co.jp');

// 適格請求書発行事業者の登録番号（T＋13桁）。
// 未取得なら定義しないでおく。架空の番号を入れないこと。
// define('KBIL_INVOICE_REG_NO', 'T1234567890123');

// 住所・電話（任意）。定義しなければ印字しません。
// define('KBIL_ZIP',  '〒000-0000');
// define('KBIL_ADDR', '東京都千代田区サンプル1-2-3');
// define('KBIL_TEL',  'TEL 03-0000-0000');

/* ── 3. 振込先 ───────────────────────────────
 * 【この製品でいちばん大事な設定】
 * ここを空のままにすると、請求書にも支払いページにも振込先が出ません。
 * 逆に言えば、ここを設定するまで他人の口座が載ることはありません。
 * （コードに口座を直接書かないのは、そのためです） */
// define('KBIL_BANK',   'サンプル銀行 本店営業部　普通 1234567');
// define('KBIL_HOLDER', 'カ）サンプル');

/* ── 4. PayPalで支払ってもらう場合だけ ──────────
 * 【重要】CLIENT_ID と SECRET の両方を設定したときだけ決済ボタンが出ます。
 * SECRET が無いと「本当に決済されたか」をサーバー側で確認できません。
 * 確認できない決済は受け付けない、というのがこの製品の方針です。
 *
 * 取得先: https://developer.paypal.com/ → Apps & Credentials
 * SECRET は絶対に公開リポジトリへ入れないこと。
// define('KBIL_PAYPAL_CLIENT_ID', '');
// define('KBIL_PAYPAL_SECRET',    '');
// 動作確認のあいだは 'sandbox'。本番は 'live'（既定）。
// define('KBIL_PAYPAL_ENV', 'live');
 */

/* ── 5. 請求の既定値（任意） ───────────────────── */
